{
  "name": "seed-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=2 .test-build/tests/*.test.js tests/*.test.mjs",
    "eval:intents": "tsc -p tsconfig.test.json && node scripts/eval-intents.mjs",
    "eval:brain": "tsc -p tsconfig.test.json && node scripts/eval-brain.mjs",
    "eval:i18n": "tsc -p tsconfig.test.json && node scripts/eval-i18n.mjs",
    "eval:reliability": "tsc -p tsconfig.test.json && node scripts/eval-reliability.mjs",
    "eval:diagnosis": "tsc -p tsconfig.test.json && node scripts/eval-diagnosis.mjs",
    "eval:journal": "tsc -p tsconfig.test.json && node scripts/eval-journal.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "staging:prepare": "node scripts/prepare-staging.mjs",
    "staging:check": "node scripts/check-staging.mjs",
    "staging:test": "node scripts/test-staging.mjs --run",
    "staging:dev": "node scripts/run-staging.mjs dev",
    "staging:build": "node scripts/run-staging.mjs build",
    "staging:start": "node scripts/run-staging.mjs start",
    "staging:browser": "node scripts/test-staging-browser.mjs --run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.8",
    "openai": "7.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
