OPENAI_API_KEY=
# Explicit environment. Non-production must never use the production database.
SEED_ENV=development
SEED_PRODUCTION_SUPABASE_REF=
# Enable only after the operations migration is tested in isolated staging.
SEED_OPERATIONS_ENABLED=false
OPENAI_MODEL=gpt-6-astra

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# Server only. Use a Supabase secret/service-role key; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Stripe TEST MODE only: rk_test_ or sk_test_. Never use live keys in phase 9.1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Map Stripe price IDs in the protected admin catalog (versioned in the database).
OPENAI_ECONOMY_MODEL=
OPENAI_STRATEGIC_MODEL=
OPENAI_PREMIUM_MODEL=

# Optional; omit for models without reasoning support. Tuned with the Phase 9.2.1 evaluation.
OPENAI_REASONING_EFFORT=low

# Phase 9.3: enable only after migration 202610010001_business_journal.sql
SEED_JOURNAL_ENABLED=false
SEED_WEEKLY_MIN_EVENTS=3
SEED_WEEKLY_MIN_DAYS=2
# Server-only bearer secret for scheduled journal worker (generate a random value).
CRON_SECRET=
# Dedicated read-only health check; never reuse CRON_SECRET or a provider key.
SEED_HEALTH_TOKEN=

# Phase 9.6: enable only after migration 202610060002_decision_simulator.sql and validation.
SEED_SIMULATOR_ENABLED=false

# Phase 9.7: enable after applying 202610080001_seed_radar.sql and validation.
SEED_RADAR_ENABLED=false

# Phase 9.8: enable after applying the migration and validating model/tool pricing.
SEED_EXTERNAL_MODE=DISABLED
# LIVE_WEB_ENABLED / OFFLINE_OR_CACHE_ONLY / DISABLED
# Optional model overrides; otherwise reuse configured economy/strategic models.
OPENAI_WEB_ECONOMY_MODEL=
OPENAI_WEB_STRATEGIC_MODEL=

# Optional ceiling for web calls per research (1-6), never raises the depth cap.
SEED_EXTERNAL_MAX_TOOL_CALLS=6

# Phase 10: requires both 202610090001 and 202610090002 migrations and the Journal worker.
SEED_GOALS_ENABLED=false

# Phase 11, enable only after 202610090003_growth_map.sql is applied
SEED_GROWTH_MAP_ENABLED=false

# Phase 12 Home; no AI on load. Enable after review.
SEED_COCKPIT_ENABLED=false

# Phase 13 internal alerts. Server-only; activate after migration and delivery test.
SEED_ALERTS_ENABLED=false
RESEND_API_KEY=
# Verified sender domain and one internal recipient. Never use NEXT_PUBLIC_ here.
SEED_ALERT_FROM=
SEED_ALERT_TO=
# Enable only after the access_retention migration and trusted Vercel edge test.
# Keeps minimal IP/time evidence for six calendar months; includes bounded purge.
SEED_ACCESS_RETENTION_ENABLED=false
